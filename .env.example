# Copy to .env and fill in. Never commit .env.
#
# Admin connection: used only by scripts/verify_db.py to create/drop scratch databases.
MUSAWIQ_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres
#
# Application connection (least-privilege role; see DB-0.19).
MUSAWIQ_DATABASE_URL=postgresql+psycopg://musawiq_app:CHANGE_ME@localhost:5432/musawiq
#
# Connection used by pytest. Overridden by verify_db.py with a scratch database.
MUSAWIQ_TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/musawiq_test
#
# Set to 1 only when RLS policies are expected (DB-0.15 onward).
MUSAWIQ_EXPECT_RLS=0

# AI providers (Module 8). Default provider is groq.
MUSAWIQ_AI_PROVIDER=groq
MUSAWIQ_GROQ_API_KEY=
MUSAWIQ_GROQ_MODEL=llama-3.3-70b-versatile
MUSAWIQ_OPENAI_API_KEY=
MUSAWIQ_OPENAI_MODEL=gpt-4o-mini
# Demo tenant headers used by the local web app (validation build).
MUSAWIQ_APP_ENV=development
# Explicit opt-in for unauthenticated demo tenant fallback. Never enable outside
# development. Prefer sending X-Store-Id/X-User-Id headers instead.
MUSAWIQ_ALLOW_DEV_TENANT_FALLBACK=false
MUSAWIQ_DEV_STORE_ID=
MUSAWIQ_DEV_USER_ID=
MUSAWIQ_DEV_USER_ROLE=owner

# Data sufficiency policy (FR-2.1.3). Version 1 requires at least 20 qualifying
# orders spanning 30 days, treats sales history older than 90 days as stale, and
# treats an audience profile older than 180 days as stale. Competitive data is
# optional and never blocks scoring. Change the version whenever these values change.
MUSAWIQ_SUFFICIENCY_POLICY_VERSION=1
MUSAWIQ_SALES_HISTORY_MIN_ORDERS=20
MUSAWIQ_SALES_HISTORY_MIN_DAYS=30
MUSAWIQ_SALES_HISTORY_STALE_DAYS=90
MUSAWIQ_AUDIENCE_STALE_DAYS=180
MUSAWIQ_COMPETITIVE_DATA_STALE_DAYS=90
# Idea evidence older than this is flagged stale in the UI/API.
MUSAWIQ_EVIDENCE_FRESHNESS_DAYS=365
