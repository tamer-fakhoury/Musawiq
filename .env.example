# Copy to .env and fill in. Never commit .env.
#
# Admin connection: used only by scripts/verify_db.py to create/drop scratch databases.
MUSAWIQ_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres
#
# Application connection (least-privilege role; see DB-0.19).
MUSAWIQ_DATABASE_URL=postgresql+psycopg://musawiq_app:CHANGE_ME@localhost:5432/musawiq
#
# Connection used by pytest. Overridden by verify_db.py with a scratch database.
MUSAWIQ_TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/musawiq_test
#
# Set to 1 only when RLS policies are expected (DB-0.15 onward).
MUSAWIQ_EXPECT_RLS=0
